{
    "name": "agrolocal/marketplace",
    "description": "Platforma e-commerce fermieri locali cu PHP 8.2, MongoDB si Stripe",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-mongodb": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "mongodb/mongodb": "^1.17",
        "stripe/stripe-php": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
